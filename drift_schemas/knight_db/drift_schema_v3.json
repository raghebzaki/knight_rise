  "fixed_sql": [
    {
      "name": "routines",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"routines\" (\"type\" TEXT NOT NULL, \"interval_minutes\" INTEGER NOT NULL, \"daily_target\" INTEGER NOT NULL, \"enabled\" INTEGER NOT NULL DEFAULT 1 CHECK (\"enabled\" IN (0, 1)), \"mode\" TEXT NOT NULL, PRIMARY KEY (\"type\"));"
        }
      ]
    },
    {
      "name": "work_windows",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"work_windows\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"weekday\" INTEGER NOT NULL, \"start_minute\" INTEGER NOT NULL, \"end_minute\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "reminder_events",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"reminder_events\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"routine_type\" TEXT NOT NULL, \"outcome\" TEXT NOT NULL, \"at\" INTEGER NOT NULL, \"scheduled_at\" INTEGER NULL, \"snoozed_until\" INTEGER NULL, \"water_ml\" INTEGER NULL);"
        }
      ]
    },
    {
      "name": "app_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_settings\" (\"id\" INTEGER NOT NULL DEFAULT 1, \"theme_variant\" TEXT NOT NULL DEFAULT 'midnight', \"precision_timing\" INTEGER NOT NULL DEFAULT 0 CHECK (\"precision_timing\" IN (0, 1)), \"water_per_tap_ml\" INTEGER NOT NULL DEFAULT 250, \"timezone_id\" TEXT NULL, \"onboarding_completed\" INTEGER NOT NULL DEFAULT 0 CHECK (\"onboarding_completed\" IN (0, 1)), \"shield_recover_on_exit\" INTEGER NOT NULL DEFAULT 1 CHECK (\"shield_recover_on_exit\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "reconcile_runs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"reconcile_runs\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"at\" INTEGER NOT NULL, \"trigger\" TEXT NOT NULL, \"planned\" INTEGER NOT NULL, \"added\" INTEGER NOT NULL, \"cancelled\" INTEGER NOT NULL, \"error\" TEXT NULL);"
        }
      ]
    },
    {
      "name": "shield_sessions",
